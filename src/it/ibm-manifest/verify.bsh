import java.io.*;
import java.util.jar.*;

File targetDir = new File( basedir, "target" );

File mainJarFile = new File( targetDir, "test-1.0.jar" );
System.out.println( "Checking for existence of " + mainJarFile );
if ( !mainJarFile.isFile() )
{
    throw new Exception( "missing " + mainJarFile );
}


File depDir = new File( targetDir, "deps" );

File jt400JarFile = new File( depDir, "jt400-10.2.jar" );
System.out.println( "Checking for existence of " + jt400JarFile );
if ( !jt400JarFile.isFile() )
{
    throw new Exception( "missing " + jt400JarFile );
}


JarFile jt400Jar = new JarFile( jt400JarFile );

System.out.println( "Checking for existence of " + jt400JarFile.getName() + "!/META-INF/TESTING.SF" );
if ( jt400Jar.getEntry( "META-INF/TESTING.SF" ) == null )
{
    throw new Exception( "missing " + jt400JarFile.getName() + "!/META-INF/TESTING.SF" );
}

System.out.println( "Checking for existence of " + jt400JarFile.getName() + "!/META-INF/TESTING.RSA" );
if ( jt400Jar.getEntry( "META-INF/TESTING.RSA" ) == null )
{
    throw new Exception( "missing " + jt400JarFile.getName() + "!/META-INF/TESTING.RSA" );
}


Manifest manifest = jt400Jar.getManifest();
Map entries = manifest.getEntries();



for (Iterator it = entries.entrySet().iterator(); it.hasNext(); ) {
    Map.Entry entry = (Map.Entry) it.next();
    Attributes attrs = (Attributes) entry.getValue();
    if (attrs.getValue("SHA1-Digest") == null && attrs.getValue("SHA-256-Digest") == null) {
        throw new Exception("Missing digest for " + entry.getKey());
    }
}

jt400Jar.close();

return true;
