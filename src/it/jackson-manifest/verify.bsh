import java.io.*;
import java.util.jar.*;

File targetDir = new File( basedir, "target" );

File mainJarFile = new File( targetDir, "test-1.0.jar" );
System.out.println( "Checking for existence of " + mainJarFile );
if ( !mainJarFile.isFile() )
{
    throw new Exception( "missing " + mainJarFile );
}


File depDir = new File( targetDir, "deps" );

File depJarFile = new File( depDir, "jackson-annotations-2.9.10.jar" );
System.out.println( "Checking for existence of " + depJarFile );
if ( !depJarFile.isFile() )
{
    throw new Exception( "missing " + depJarFile );
}


JarFile depJar = new JarFile( depJarFile );

System.out.println( "Checking for existence of " + depJarFile.getName() + "!/META-INF/TESTING.SF" );
if ( depJar.getEntry( "META-INF/TESTING.SF" ) == null )
{
    throw new Exception( "missing " + depJarFile.getName() + "!/META-INF/TESTING.SF" );
}

System.out.println( "Checking for existence of " + depJarFile.getName() + "!/META-INF/TESTING.RSA" );
if ( depJar.getEntry( "META-INF/TESTING.RSA" ) == null )
{
    throw new Exception( "missing " + depJarFile.getName() + "!/META-INF/TESTING.RSA" );
}


Manifest manifest = depJar.getManifest();

System.out.println( "Checking for existence of " + depJarFile.getName() + "!/META-INF/LICENSE" );
if ( depJar.getEntry( "META-INF/LICENSE" ) == null )
{
    throw new Exception( "missing " + depJarFile.getName() + "!/META-INF/LICENSE" );
}


Attributes attrs = manifest.getAttributes("META-INF/LICENSE");
if (attrs == null) {
    throw new Exception("Missing manifest attribute for META-INF/LICENSE");
}
if (attrs.getValue("SHA1-Digest") == null && attrs.getValue("SHA-256-Digest") == null) {
    throw new Exception("Missing digest for META-INF/License");
}

depJar.close();

return true;
